# Darzibaba environment configuration
# Copy to .env and adjust for your machine (never commit .env)

CI_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3310
DB_USER=root
DB_PASSWORD=
DB_NAME=alibaba

# Set true when serving over HTTPS
COOKIE_SECURE=false

# Reliable offline ERP (IndexedDB + auto sync). Same UI; header shows Online/Offline + Sync.
OFFLINE_DESK_ENABLED=true

# Free local WhatsApp bridge (see bridge/whatsapp-bridge/README.md)
WHATSAPP_BRIDGE_ENABLED=true
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3099
WHATSAPP_BRIDGE_SECRET=

# Optional: allow HTTP cron if CLI unavailable (php index.php cron ... preferred)
# CRON_HTTP_SECRET=change_me_long_random

# Optional: free local AI for report voice (install Ollama — https://ollama.com)
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Personal WhatsApp number for auto-sending report PDFs (e.g. 03001234567 or 923001234567)
REPORT_OWNER_PHONE=

# Staff offline-first sync (IndexedDB + /api/erp_sync)
# Token lifetime in days for offline session after login
ERP_SYNC_TOKEN_DAYS=7

# Darzi Baba public website (Next.js → CI3 API)
WEBSITE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# When WhatsApp bridge is down, return OTP in API JSON (development only)
WEBSITE_OTP_DEBUG=false
