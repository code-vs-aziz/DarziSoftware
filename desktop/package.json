{
  "name": "darzi-baba-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for the real Darzi Baba PHP ERP (same UI)",
  "main": "main.js",
  "private": true,
  "author": "Darzi Baba",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.darzibaba.erp",
    "productName": "Darzi Baba ERP",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json",
      "build/**/*"
    ],
    "extraResources": [],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1"
  }
}
